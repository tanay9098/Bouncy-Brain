# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-vercel-app.vercel.app

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas (external - free tier works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bouncybrain

# ── Cache / Queue ─────────────────────────────────────────────────────────────
# Railway Redis plugin: copy the REDIS_URL from the Redis service Variables tab
REDIS_URL=redis://default:<password>@redis.railway.internal:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# ── Third-party APIs ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── ML Microservice ───────────────────────────────────────────────────────────
# URL of the deployed ML service on Railway
ML_SERVICE_URL=https://ml-service.railway.app
