{
  "manifest_version": 3,
  "name": "JumpyBrain",
  "version": "1.0.0",
  "description": "ADHD productivity companion — tasks, focus timer, and smart ML recommendations in your browser.",
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "tabs"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*.railway.app/*",
    "https://*.vercel.app/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "JumpyBrain",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
